# Salin file ini jadi "config.env" lalu isi datamu.
# config.env dibaca otomatis saat script dijalankan (tidak perlu export).

# Wajib — email FaucetPay yang terdaftar di limefaucet.com
LIME_EMAIL=isi_email_kamu@faucetpay.email

# OPSIONAL — API key api.waryono.my.id (solver Turnstile + method "lime").
# Status: TIDAK DIPAKAI (dihapus). Baris ini boleh dihapus sepenuhnya.
# Kalau dikosongkan/dihapus: faucet + YouTube tetap jalan (GRATIS),
# tapi PTC, Daily Bonus, dan shortlink dilewati karena butuh Turnstile.
CAPTCHA_APIKEY=

# Opsional
# LIME_PROXY=http://user:pass@host:port

# --- Hemat token (apikey solver) ---------------------------------------
# Batas token per proses (0 = tanpa batas)
TOKEN_BUDGET=0
# Jangan pakai token sampai saldo tinggal segini (pelindung cadangan)
TOKEN_RESERVE=100
# Harga token USD per 1000 → aktifkan filter ROI + laporan biaya.
# Contoh: TOKEN_PRICE=0.5 artinya 1 token = $0.0005; iklan PTC yang
# hadiahnya di bawah itu otomatis dilewati.
TOKEN_PRICE=0
